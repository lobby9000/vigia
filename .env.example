# Copy to .env and replace every change-me (scripts/bootstrap.sh does it for you
# with random values). .env is in .gitignore: never commit real secrets.
POSTGRES_DB=vigia
POSTGRES_USER=vigia
POSTGRES_PASSWORD=change-me
# Shared by the analytics API (signs tokens) and the ingest service (verifies them).
# At least 32 characters: openssl rand -hex 32
JWT_SECRET=change-me
DJANGO_SECRET_KEY=change-me
# Passwords for the demo users created by scripts/bootstrap.sh
VIGIA_ADMIN_PASSWORD=change-me
VIGIA_VIEWER_PASSWORD=change-me
